<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BoardGame.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ghim bản vá cho 2 gói transitive bị "dotnet list package vulnerable" báo High (2026-09-11)
         — không package nào ở trên trực tiếp khai báo chúng, NuGet kéo về bản 8.0.0 gốc có lỗ
         hổng (System.Text.Json: 2 CVE DoS; Caching.Memory: 1 CVE DoS). Ghim thẳng bản vá mới
         nhất trong cùng dòng 8.0.x (không nâng major) — rủi ro breaking thấp, cùng cách đã làm
         với Microsoft.EntityFrameworkCore ở BoardGame.Api.Tests.csproj. -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />

    <!-- Database (PostgreSQL via EF Core) -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Cache (Redis) -->
    <PackageReference Include="StackExchange.Redis" Version="2.7.33" />

    <!-- Queue (RabbitMQ) -->
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />

    <!-- Search (OpenSearch) -->
    <PackageReference Include="OpenSearch.Client" Version="1.7.1" />

    <!-- Storage (MinIO, S3-compatible) -->
    <PackageReference Include="Minio" Version="6.0.2" />

    <!-- API docs -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>

# Copy thành .env (đã gitignore) rồi điền giá trị thật. KHÔNG commit file .env.
# File .env.example này NẰM TRONG GIT — không bao giờ điền credential thật vào đây.

# JWT ký phiên đăng nhập — chuỗi ngẫu nhiên >= 32 ký tự.
# Không đặt thì compose dùng giá trị dev mặc định (chỉ chấp nhận được trên máy local).
JWT_SECRET=

# Đăng nhập OTP qua email — gửi thật qua Gmail (SMTP).
# EMAIL_PROVIDER=smtp để bật gửi thật; để trống thì OTP in ra log backend (chỉ local).
EMAIL_PROVIDER=smtp
WEB_BASE_URL=http://localhost:5175
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# ↓↓↓ ĐIỀN 2 DÒNG NÀY (App Password của Google: https://myaccount.google.com/apppasswords,
# cần bật xác minh 2 bước — KHÔNG phải mật khẩu Gmail thường):
SMTP_USER=@gmail.com
SMTP_PASS=
# SMTP_FROM: tên hiển thị người gửi — email trong <...> PHẢI trùng SMTP_USER ở trên
SMTP_FROM=BoardGame <@gmail.com>